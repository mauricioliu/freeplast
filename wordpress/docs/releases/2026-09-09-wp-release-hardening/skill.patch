new file mode 100644
index 0000000..1f97a9d
--- /dev/null
+++ b/scripts/release-common.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+# Shared by the immutable release chain and generated rollback wrapper.
+set -euo pipefail
+fail() { echo "wp-release-chain: $*" >&2; exit 1; }
+log() { echo "wp-release-chain: $*"; }
+ID="${WP_RELEASE_ID:?}"
+STACK_DIR="${STACK_DIR:?}"; WP_ROOT="${WP_ROOT:?}"; HOME_URL="${HOME_URL:?}"
+BUNDLE_HOST_DIR="${BUNDLE_HOST_DIR:?}"; BUNDLE_PATH="${BUNDLE_PATH:?}"
+BACKUP_DIR="${BACKUP_DIR:?}"; DEST="$BACKUP_DIR/$ID"
+read -r -a WP <<< "${WP_RUN:?}"
+EXEC=(); [ -z "${EXEC_RUN:-}" ] || read -r -a EXEC <<< "$EXEC_RUN"
+FILES_TAR="${FILES_TAR:?}"; CHECK_EXPR="${REHEARSAL_CHECK:?}"
+INSTALL_THEMES="${INSTALL_THEMES:-}"; INSTALL_PLUGINS="${INSTALL_PLUGINS:-}"
+EXPECTED_VERSIONS="${EXPECTED_VERSIONS:-}"
+VERIFY_HOOK="${VERIFY_HOOK:-}"; FINGERPRINT_HOOK="${FINGERPRINT_HOOK:-}"
+cd "$STACK_DIR"
+# Non-streaming commands must not consume a rollback operator's confirmation.
+wpr() { "${WP[@]}" "$@" < /dev/null; }
+wpr_input() { "${WP[@]}" "$@"; }
+exec_in_wp_root() {
+  if [ "${#EXEC[@]}" -eq 0 ]; then (cd "$WP_ROOT" && "$@"); else "${EXEC[@]}" "$@"; fi
+}
+assert_home() { [ "$(wpr --skip-plugins --skip-themes option get home)" = "$HOME_URL" ] || fail "wrong target: home != $HOME_URL"; }
+bundle_check() { (cd "$BUNDLE_HOST_DIR" && sha256sum -c SHA256SUMS >/dev/null) || fail 'bundle integrity failed'; }
+backup_check() { (cd "$DEST" && sha256sum -c SHA256SUMS >/dev/null) || fail 'backup integrity failed'; }
+live_check() {
+  local value; value="$(wpr eval "$CHECK_EXPR")" || return $?
+  [[ "$value" =~ ^[0-9]+$ ]] || fail 'LIVE-CHECK must be a bare integer'
+  printf '%s\n' "$value"
+}
+fingerprint() {
+  [ -n "$FINGERPRINT_HOOK" ] || fail 'a protected-record fingerprint hook is required'
+  local value; value="$(wpr --skip-plugins --skip-themes eval-file "$BUNDLE_PATH/$FINGERPRINT_HOOK")" || return $?
+  [[ "$value" =~ ^[0-9a-f]{64}$ ]] || fail 'fingerprint hook must print one 64-hex digest'
+  printf '%s\n' "$value"
+}
+maintenance() { exec_in_wp_root php /dev/stdin "$1" "$ID" < "$BUNDLE_HOST_DIR/maintenance.php"; }
+retain_on_failure() {
+  local code=$?
+  trap - EXIT
+  if [ "$code" -ne 0 ]; then
+    if maintenance hold; then echo 'FAILED: maintenance retained; investigate or roll back before reopening' >&2
+    else echo 'CRITICAL: could not confirm maintenance; operator intervention required' >&2; fi
+  fi
+  exit "$code"
+}
+start_guard() { maintenance hold; trap retain_on_failure EXIT; }
+assert_versions() {
+  local pair kind rest slug ver
+  for pair in $EXPECTED_VERSIONS; do
+    kind="${pair%%:*}"; rest="${pair#*:}"; slug="${rest%%=*}"; ver="${rest#*=}"
+    [ "$(wpr "$kind" get "$slug" --field=version)" = "$ver" ] || fail "$kind $slug version != $ver"
+  done
+}
+assert_installed() {
+  exec_in_wp_root sha256sum -c - < "$BUNDLE_HOST_DIR/INSTALLED-SHA256SUMS" || fail 'installed files do not match packaged hashes'
+  assert_versions
+  if [ -n "$VERIFY_HOOK" ]; then wpr eval-file "$BUNDLE_PATH/$VERIFY_HOOK" || fail 'state verification hook failed'; fi
+}
diff --git a/scripts/release-rollback.sh b/scripts/release-rollback.sh
new file mode 100644
index 0000000..a509bff
--- /dev/null
+++ b/scripts/release-rollback.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+# Called only by the per-bundle rollback.sh wrapper. Prepared != executed.
+set -euo pipefail
+source "$(dirname "${BASH_SOURCE[0]}")/release-common.sh"
+MODE="${1:-}"; [ "$#" -eq 0 ] || shift
+ACK=''; AUTH=''; EXPECTED=''
+while [ "$#" -gt 0 ]; do
+  case "$1" in
+    --acknowledge-data-loss-risk) ACK=1; shift;;
+    --authorized|--expected-current-fingerprint)
+      [ "$#" -ge 2 ] && [[ "$2" != --* ]] || fail "missing value for $1"
+      if [ "$1" = --authorized ]; then AUTH="$2"; else EXPECTED="$2"; fi; shift 2;;
+    *) fail "unknown rollback argument: $1";;
+  esac
+done
+case "$MODE" in inspect|code-only|paired) ;; *) fail 'usage: rollback.sh inspect | code-only --authorized "quote" | paired --authorized "quote" --acknowledge-data-loss-risk --expected-current-fingerprint <digest>';; esac
+bundle_check
+assert_home
+if [ "$MODE" = inspect ]; then
+  printf 'target: %s\nrelease: %s\nfingerprint: %s\n' "$HOME_URL" "$ID" "$(fingerprint)"
+  exit 0
+fi
+[ -n "$AUTH" ] || fail 'rollback requires fresh explicit owner authorization'
+
+if [ "$MODE" = code-only ]; then
+  [ -n "${PREVIOUS_BUNDLE_HOST:-}" ] || fail 'no completed previous bundle; code-only unavailable'
+  [ -n "${ROLLBACK_VERSIONS:-}" ] || fail 'previous bundle has no verified version metadata'
+  (cd "$PREVIOUS_BUNDLE_HOST" && sha256sum -c SHA256SUMS >/dev/null) || fail 'previous bundle integrity failed'
+  start_guard
+  before="$(fingerprint)"
+  for it in ${ROLLBACK_THEMES:-}; do wpr --skip-plugins --skip-themes theme install "$PREVIOUS_BUNDLE_PATH/${it#*=}" --force; done
+  for it in ${ROLLBACK_PLUGINS:-}; do wpr --skip-plugins --skip-themes plugin install "$PREVIOUS_BUNDLE_PATH/${it#*=}" --force; done
+  maintenance hold
+  exec_in_wp_root sha256sum -c - < "$PREVIOUS_BUNDLE_HOST/INSTALLED-SHA256SUMS" || fail 'rollback installed files differ from previous bundle'
+  EXPECTED_VERSIONS="$ROLLBACK_VERSIONS"; assert_versions
+  # The previous hook describes the previous code; the current fingerprint
+  # contract checks that the code-only operation did not alter protected data.
+  if [ -n "${ROLLBACK_VERIFY_HOOK:-}" ]; then wpr eval-file "$PREVIOUS_BUNDLE_PATH/$ROLLBACK_VERIFY_HOOK"; fi
+  [ "$(fingerprint)" = "$before" ] || fail 'code-only rollback changed protected records'
+else
+  [ "$ACK" = 1 ] || fail 'paired restore erases post-backup writes; explicit risk acknowledgement required'
+  [[ "$EXPECTED" =~ ^[0-9a-f]{64}$ ]] || fail 'provide the fresh fingerprint from rollback.sh inspect'
+  backup_check
+  [ "$(fingerprint)" = "$EXPECTED" ] || fail 'current fingerprint changed; inspect and authorize again'
+  # Check archive names before any destructive operation. GNU tar is required.
+  entries="$(tar -tzf "$DEST/files.tgz")"
+  [[ "$entries" != /* ]] && ! grep -Eq '(^/|(^|/)\.\.(/|$))' <<< "$entries" || fail 'unsafe backup archive paths'
+  grep -Eq '^(\./)?wp-config.php$' <<< "$entries" || fail 'backup does not contain wp-config.php'
+  printf 'Restore database AND files into %s? Type RESTORE: ' "$HOME_URL"
+  read -r answer || fail 'restore confirmation missing'; [ "$answer" = RESTORE ] || fail 'restore cancelled'
+  start_guard
+  [ "$(fingerprint)" = "$EXPECTED" ] || fail 'fingerprint changed while awaiting confirmation'
+  # Remove post-backup files as well as overwriting old ones. Persistent guards
+  # stay outside the deletion set. Backup and bundle must be outside WP_ROOT.
+  exec_in_wp_root find . -mindepth 1 -maxdepth 1 ! -name .maintenance ! -name .wp-release-lock -exec rm -rf -- '{}' +
+  exec_in_wp_root tar -xzf - -C "$WP_ROOT" --exclude=./.maintenance --exclude=./.wp-release-lock < "$DEST/files.tgz"
+  maintenance hold
+  exec_in_wp_root sha256sum -c - < "$DEST/FILES-SHA256SUMS" || fail 'restored files differ from backup'
+  # stdin works for both bare wp and a CLI container; never give it a host path.
+  wpr db reset --yes
+  wpr_input db import - < "$DEST/db.sql"
+  assert_home
+  [ "$(fingerprint)" = "$(cat "$DEST/FINGERPRINT")" ] || fail 'restored protected fingerprint differs from backup'
+  [ "$(live_check)" = "$(cat "$DEST/LIVE-CHECK")" ] || fail 'restored LIVE-CHECK differs from backup'
+fi
+assert_home
+wpr cache flush
+maintenance release
+trap - EXIT
+printf 'rollback: %s complete\n' "$MODE"
