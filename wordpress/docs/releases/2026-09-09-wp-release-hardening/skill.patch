+#!/usr/bin/env node
+import assert from 'node:assert/strict';
+import {mkdtempSync,mkdirSync,writeFileSync,existsSync,readFileSync,rmSync,cpSync} from 'node:fs';
+import {join,dirname} from 'node:path';
+import {tmpdir} from 'node:os';
+import {fileURLToPath} from 'node:url';
+import {spawnSync} from 'node:child_process';
+const skill=join(dirname(fileURLToPath(import.meta.url)),'..');
+const root=mkdtempSync(join(tmpdir(),'wp-release-cli-'));
+let count=0;
+try {
+  const driver=join(skill,'scripts/release.mjs');
+  const run=(args,bin=driver,env={})=>spawnSync(process.execPath,[bin,'--config',join(root,'wp-release.json'),...args],{encoding:'utf8',env:{...process.env,...env}});
+  for(const args of [['run','--typo'],['run','--authorized','--through','transfer'],['run','extra'],['status','--dry-run'],['run','--through','bogus'],['resume','--id','../../elsewhere']]) {
+    assert.equal(run(args).status,2,JSON.stringify(args));count++;
+  }
+  assert.equal(run(['--help']).status,0);count++;
+  mkdirSync(join(root,'src/theme'),{recursive:true});writeFileSync(join(root,'src/theme/style.css'),'Version: 1.0.0\n');writeFileSync(join(root,'finger.php'),'<?php echo str_repeat("a",64);');
+  const cfg={project:'cli-negative',target:{ssh:'',stackDir:root,wpRoot:join(root,'wp'),wp:`touch ${join(root,'TARGET-TOUCHED')}`,exec:'',filesTar:'false',bundleDir:'bundles',backupDir:'backups',homeUrl:'https://fixture.invalid'},gate:'true',rehearsal:{env:'local'},packaging:{sources:[{from:'src/theme',zip:'theme.zip'}]},artifacts:['theme.zip'],install:{themes:[{slug:'theme',artifact:'theme.zip'}],plugins:[]},hooks:{recordFingerprint:'finger.php'},tiers:{surface:['src/**'],logic:[],data:[]},smoke:[],record:{dir:'records'}};
+  writeFileSync(join(root,'wp-release.json'),JSON.stringify(cfg));
+  let r=run(['run','--id','dry','--tier-confirmed','surface','--dry-run','--through','record']);assert.equal(r.status,0,r.stdout+r.stderr);
+  const state=JSON.parse(readFileSync(join(root,'.build/wp-release/dry/state.json'),'utf8'));assert.deepEqual(Object.keys(state.phases),['gate','package']);assert.ok(!existsSync(join(root,'bundles')));assert.ok(!existsSync(join(root,'TARGET-TOUCHED')));count++;
+  r=run(['run','--id','local-package','--tier-confirmed','surface','--through','package','--authorized','old quote']);assert.equal(r.status,0,r.stdout+r.stderr);
+  r=run(['resume','--id','local-package','--through','transfer']);assert.notEqual(r.status,0);assert.match(r.stderr,/current owner quote/);assert.ok(!existsSync(join(root,'TARGET-TOUCHED')));count++;
+  // A copied/modified skill has no certificate, even if a fixture environment
+  // variable is supplied. Blocking happens before its configured WP runner.
+  const copy=join(root,'uncertified');cpSync(skill,copy,{recursive:true});rmSync(join(copy,'.self-test.json'),{force:true});
+  r=run(['resume','--id','local-package','--through','transfer','--authorized','fresh quote'],join(copy,'scripts/release.mjs'),{WP_RELEASE_TEST_WORKSPACE:root});
+  assert.notEqual(r.status,0);assert.match(r.stderr,/Safety certification missing\/stale/);assert.ok(!existsSync(join(root,'bundles')));assert.ok(!existsSync(join(root,'TARGET-TOUCHED')));count++;
+  cfg.target.homeUrl='https://another.invalid';writeFileSync(join(root,'wp-release.json'),JSON.stringify(cfg));
+  r=run(['resume','--id','local-package','--authorized','fresh quote']);assert.notEqual(r.status,0);assert.match(r.stderr,/changed configuration/);assert.ok(!existsSync(join(root,'TARGET-TOUCHED')));count++;
+  console.log(`cli: ${count} argument/dry-run/authorization/certification/config-seal cases passed`);
+} finally {rmSync(root,{recursive:true,force:true});}
