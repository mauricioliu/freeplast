@@ -0,0 +1,44 @@
+<?php
+// Run via PHP CLI in the WordPress root, never via HTTP or WordPress bootstrap.
+if (PHP_SAPI !== 'cli') { http_response_code(403); exit(1); }
+function stop_release(string $message): never { fwrite(STDERR, $message . "\n"); exit(1); }
+[$script, $mode, $id] = $argv + [null, null, null];
+if (!in_array($mode, ['hold', 'check', 'release'], true) || !preg_match('/^[A-Za-z0-9_-]+$/D', $id ?? '')) { stop_release('Invalid maintenance operation/id'); }
+if (!is_file('wp-config.php') || !is_dir('wp-includes')) { stop_release('Not a WordPress root'); }
+$lock = '.wp-release-lock';
+$guard = 'wp-content/mu-plugins/wp-release-guard.php';
+$maintenance = "<?php /* wp-release owned */ \$upgrading = time();\n";
+// Native upgraders may delete .maintenance. The independent MU guard keeps
+// requests closed across that deletion, and does not expire after ten minutes.
+$guardCode = <<<'PHP'
+<?php
+/* wp-release owned */
+if (!(defined('WP_CLI') && WP_CLI) && is_dir(ABSPATH . '.wp-release-lock')) {
+    http_response_code(503);
+    header('Retry-After: 600');
+    header('Cache-Control: no-store');
+    exit('Briefly unavailable for scheduled maintenance.');
+}
+PHP;
+if (is_link($lock) || is_link($guard) || is_link('.maintenance')) { stop_release('Refusing symlinked maintenance files'); }
+if ($mode === 'hold' && !is_dir($lock)) {
+    if (file_exists($guard) || file_exists('.maintenance')) { stop_release('Unowned maintenance already exists'); }
+    if (!mkdir($lock, 0755)) { stop_release('Cannot acquire maintenance lock'); }
+    if (file_put_contents("$lock/owner", $id) === false) { stop_release('Cannot write lock owner'); }
+}
+if (!is_dir($lock) || @file_get_contents("$lock/owner") !== $id) { stop_release('Maintenance lock belongs to another operation (or is missing)'); }
+if ($mode === 'check') {
+    if (@file_get_contents($guard) !== $guardCode || @file_get_contents('.maintenance') !== $maintenance) { stop_release('Maintenance guards missing or modified'); }
+    exit(0);
+}
+if ($mode === 'hold') {
+    if (file_exists($guard) && file_get_contents($guard) !== $guardCode) { stop_release('Refusing to replace another MU guard'); }
+    if (file_exists('.maintenance') && file_get_contents('.maintenance') !== $maintenance) { stop_release('Refusing to replace another maintenance file'); }
+    if (!is_dir(dirname($guard)) && !mkdir(dirname($guard), 0755, true)) { stop_release('Cannot create MU directory'); }
+    foreach ([$guard => $guardCode, '.maintenance' => $maintenance] as $file => $code) {
+        if (file_put_contents($file . '.wp-release-tmp', $code) === false || !rename($file . '.wp-release-tmp', $file)) { stop_release('Cannot write maintenance guard'); }
+    }
+} else {
+    if (@file_get_contents($guard) !== $guardCode || @file_get_contents('.maintenance') !== $maintenance) { stop_release('Refusing to remove modified maintenance guards'); }
+    if (!unlink('.maintenance') || !unlink($guard) || !unlink("$lock/owner") || !rmdir($lock)) { stop_release('Cannot release maintenance'); }
+}
