# Freeplast staging — environment template (issue #14).
#
# deploy.sh generates every secret on the server (openssl rand) into
# /opt/freeplast-wordpress/.env with mode 0600. This template carries
# names and comments only — never a value (OPENCLAW.md).
#
# Non-secret inputs deploy.sh requires in its environment:
#   TLS_CERT_PATH / TLS_KEY_PATH  the server's approved certificate
#   WORDPRESS_ADMIN_EMAIL         the owner-approved administrator address
#   FREEPLAST_GOOGLE_API_KEY      optional console-restricted key

# ── MariaDB (secrets generated by deploy.sh) ──
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USER=
MARIADB_PASSWORD=

# ── WordPress administrator (secret generated by deploy.sh; the value is
#    transferred through the owner-approved secret channel only) ──
WORDPRESS_ADMIN_USER=
WORDPRESS_ADMIN_EMAIL=
WORDPRESS_ADMIN_PASSWORD=

# ── Published origin — loopback only; the host Nginx proxies the approved
#    hostname and terminates TLS (deploy.sh writes 8092, matching
#    nginx/freeplast.mliu.site.conf) ──
FREEPLAST_LOOPBACK_PORT=

# ── TLS: the server's approved convention (preflight.sh verifies the
#    certificate exists, covers freeplast.mliu.site and is not near
#    expiry before anything changes) ──
TLS_CERT_PATH=
TLS_KEY_PATH=

# ── Owner/client Basic Auth review credentials (secrets generated by
#    deploy.sh) ──
BASIC_AUTH_OWNER_USER=
BASIC_AUTH_OWNER_PASSWORD=
BASIC_AUTH_CLIENT_USER=
BASIC_AUTH_CLIENT_PASSWORD=

# ── Staging notification containment (issue #10) — deploy.sh writes
#    suppress (non-delivery) until the owner approves test recipients;
#    redirect additionally needs FREEPLAST_CQ_MAIL_TO (an approved test
#    address only). live is a production-only value. The plugin also
#    fails closed when unset. ──
FREEPLAST_CQ_MAIL_MODE=
FREEPLAST_CQ_MAIL_TO=

# ── Optional Google Places/Routes key (hostname/API-restricted in the
#    Google console; never committed) ──
FREEPLAST_GOOGLE_API_KEY=
